# Porta do servidor HTTP
PORT=3001

# Chave secreta da Stripe (Modo Live ou Test: sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=sk_live_sua_chave_aqui

# Segredo de assinatura do webhook gerado no Dashboard da Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret_aqui

# Conexão com o mesmo banco MongoDB usado pelo Bot
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/lolbr_bot?retryWrites=true&w=majority

# Token do Bot do Discord (para atribuir cargos e enviar logs instantaneamente via REST API)
DISCORD_TOKEN=seu_bot_token_aqui
